// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  role      String     @default("user")
  credits      Float      @default(0)
  totalCostUSD Float      @default(0)
  allowedModels String[]   @default(["gemini", "claude", "openai"])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspaces    Workspace[]
  agents        Agent[]
  chatSessions  ChatSession[]
  usageLogs     UsageLog[]
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  intake            WorkspaceIntake?
  agents            Agent[]
  repositoryItems   RepositoryItem[]
  threads           Thread[]
  intakeForms       IntakeForm[]

  @@index([userId])
}

model WorkspaceIntake {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  department   String?
  industry     String?
  companySize  String?
  goal         String?
  challenges   String?
  resources    String?
  timeline     String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IntakeForm {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  companyName  String
  contactEmail String
  contactPhone String?
  department   String
  industry     String
  companySize  String
  currentState String?
  mainGoals    String[]
  challenges   String[]
  resources    String?
  timeline     String?
  budget       String?
  status       String   @default("draft")
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
}

model Agent {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String
  role            String
  department_name String
  description     String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  threads         Thread[]

  @@index([workspaceId])
  @@index([userId])
}

model Thread {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]

  @@index([agentId])
  @@index([workspaceId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  
  role      String   // "user" or "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([threadId])
}

model RepositoryItem {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  title       String
  content     String   @db.Text
  type        String   // "document", "code", "knowledge", etc.
  pinned      Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}




model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  documents ChatDocument[]
  chunks    DocumentChunk[]

  @@index([userId])
}

model ChatMessage {
  id         String      @id @default(cuid())
  chatId     String
  chat       ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role       String
  content    String      @db.Text
  escalation Json?
  createdAt  DateTime    @default(now())

  @@index([chatId])
}

model ChatDocument {
  id        String      @id @default(cuid())
  chatId    String
  chat      ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
  name      String
  type      String
  content   String?     @db.Text // Optional content/base64 for small files or reference
  createdAt DateTime    @default(now())

  @@index([chatId])
}

model DocumentChunk {
  id        String      @id @default(cuid())
  chatId    String
  chat      ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
  content   String      @db.Text
  source    String
  createdAt DateTime    @default(now())

  @@index([chatId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model UsageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputTokens  Int
  outputTokens Int
  creditsUsed  Float
  costUSD      Float
  model        String
  provider     String
  createdAt    DateTime @default(now())

  @@index([userId])
}
